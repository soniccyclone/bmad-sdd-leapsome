{
  "permissions": {
    "allow": [
      "Bash(bd close:*)",
      "Bash(git add:*)",
      "Bash(docker compose:*)",
      "Bash(curl -s -X POST http://localhost:3000/api/todos -H 'Content-Type: application/json' -d '{\"description\":\"test todo\"}')",
      "Bash(curl -s -o /dev/null -w '%{http_code}' http://localhost:8080)",
      "Bash(npm test:*)",
      "Bash(npx --workspace=packages/frontend vite build)",
      "Bash(curl -s http://localhost:3000/health)",
      "Bash(curl -s -X POST http://localhost:3000/api/todos -H 'Content-Type: application/json' -d '{\"description\":\"Buy groceries\"}')",
      "Bash(curl -s \"http://localhost:3000/api/todos?page=1&limit=10\")",
      "Bash(npx playwright:*)",
      "Bash(npx vitest:*)",
      "Bash(gh run:*)",
      "mcp__chrome-devtools__list_network_requests",
      "mcp__chrome-devtools__take_snapshot",
      "mcp__chrome-devtools__navigate_page",
      "mcp__chrome-devtools__list_console_messages",
      "mcp__chrome-devtools__fill",
      "mcp__chrome-devtools__click",
      "mcp__chrome-devtools__take_screenshot",
      "mcp__playwright__browser_navigate",
      "mcp__playwright__browser_snapshot",
      "mcp__playwright__browser_take_screenshot",
      "mcp__playwright__browser_click",
      "mcp__playwright__browser_type",
      "mcp__chrome-devtools__lighthouse_audit",
      "mcp__playwright__browser_resize",
      "mcp__chrome-devtools__wait_for",
      "Bash(bd show:*)",
      "Bash(git commit -m ':*)"
    ]
  },
  "hooks": {
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bd prime"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bd prime"
          }
        ]
      }
    ]
  }
}
